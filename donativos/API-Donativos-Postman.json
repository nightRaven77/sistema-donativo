            {
              "name": "Stock Disponible",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/catalogos/articulo/stock/1",
                  "host": ["{{baseUrl}}"],
                  "path": ["catalogos", "articulo", "stock", "1"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "[\n  {\n    \"idArticulo\": 1,\n    \"nombre\": \"Arroz Blanco\",\n    \"idCategoria\": 1,\n    \"nombreCategoria\": \"Alimentos\",\n    \"stockActual\": 150.5,\n    \"idAlmacen\": 1,\n    \"nombreAlmacen\": \"Almacén Central\",\n    \"fechaUltimaEntrada\": \"2024-03-01T10:30:00\",\n    \"fechaUltimaSalida\": \"2024-03-05T14:15:00\",\n    \"activo\": true\n  },\n  {\n    \"idArticulo\": 2,\n    \"nombre\": \"Frijol Negro\",\n    \"idCategoria\": 1,\n    \"nombreCategoria\": \"Alimentos\",\n    \"stockActual\": 85.0,\n    \"idAlmacen\": 1,\n    \"nombreAlmacen\": \"Almacén Central\",\n    \"fechaUltimaEntrada\": \"2024-02-28T09:00:00\",\n    \"fechaUltimaSalida\": null,\n    \"activo\": true\n  }\n]"
            },
            {
              "name": "Con Búsqueda",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/catalogos/articulo/stock/1?buscar=arroz",
                  "host": ["{{baseUrl}}"],
                  "path": ["catalogos", "articulo", "stock", "1"],
                  "query": [
                    {
                      "key": "buscar",
                      "value": "arroz"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "[\n  {\n    \"idArticulo\": 1,\n    \"nombre\": \"Arroz Blanco\",\n    \"stockActual\": 100.0,\n    \"nombreAlmacen\": \"Almacén Central\"\n  },\n  {\n    \"idArticulo\": 5,\n    \"nombre\": \"Arroz Integral\",\n    \"stockActual\": 50.5,\n    \"nombreAlmacen\": \"Almacén Central\"\n  }\n]"
            },
