<!-- Script para mostrar/ocultar importe según tipo de donativo -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const selectTipoDonativo = document.getElementById('selectTipoDonativo');
        const grupoImporte = document.getElementById('grupoImporte');
        const numberImporte = document.getElementById('numberImporte');
        const btnCancelar = document.getElementById('btnCancelar');
        const formRegistroDonativos = document.getElementById('formRegistroDonativos');

        
        

        if (selectTipoDonativo) {
            selectTipoDonativo.addEventListener('change', function() {
                if (this.value === 'efectivo') {
                    grupoImporte.style.display = 'block';
                    numberImporte.required = true;
                } else {
                    grupoImporte.style.display = 'none';
                    numberImporte.required = false;
                    numberImporte.value = '';
                }
            });
        }
    });


    /**
     * Editar un donativo
     */
    function editarDonativo(idDonativo) {
        toastr.info('Función de edición en desarrollo', 'Información');
        // Implementar edición
    }

    /**
     * Eliminar un donativo
     */
    function eliminarDonativo(idDonativo) {
        if (confirm('¿Estás seguro de que deseas eliminar este donativo?')) {
            $.ajax({
                type: 'DELETE',
                url: `/Registros/EliminarDonativo/${idDonativo}`,
                dataType: 'json',
                success: function (response) {
                    console.log('Donativo eliminado:', response);
                    toastr.success('Donativo eliminado correctamente', 'Éxito');
                    cargarDonativos(); // Refrescar tabla
                },
                error: function (xhr, status, error) {
                    console.error('Error al eliminar:', error);
                    toastr.error('Error al eliminar el donativo', 'Error');
                }
            });
        }
    }
</script>
