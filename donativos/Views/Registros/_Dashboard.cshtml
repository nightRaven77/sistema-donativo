<div class="bg-white rounded-lg shadow-md p-8">
    <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-black text-[#2d2d2d] border-b-4 border-dorado inline-block pb-2" style="color: var(--guinda);">
            <i class="fas fa-chart-line mr-2"></i>Panel de Control Operativo
        </h2>
        <button type="button" class="btn btn-sm btn-dorado" onclick="App.loadView(event, 'consulta')">
            <i class="fas fa-search mr-1"></i> Ver Estadísticas Detalladas
        </button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <div class="bg-gradient-to-br from-blue-50 to-white border border-blue-200 rounded-lg p-6 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-bold uppercase text-stone-500">Entradas</p>
                    <h3 class="text-xl font-black mt-1" style="color: var(--guinda);">Recepción de Donativos</h3>
                </div>
                <i class="fas fa-hand-holding-heart text-3xl" style="color: var(--dorado);"></i>
            </div>
            <button type="button" class="btn btn-sm btn-guinda mt-4 w-full" onclick="App.loadView(event, 'registros')">
                Registrar Entrada
            </button>
        </div>

        <div class="bg-gradient-to-br from-sky-50 to-white border border-sky-200 rounded-lg p-6 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-bold uppercase text-stone-500">Entregas</p>
                    <h3 class="text-xl font-black mt-1" style="color: var(--guinda);">Salidas a Beneficiarios</h3>
                </div>
                <i class="fas fa-box-open text-3xl" style="color: var(--dorado);"></i>
            </div>
            <button type="button" class="btn btn-sm btn-guinda mt-4 w-full" onclick="App.loadView(event, 'salidas')">
                Gestionar Salidas
            </button>
        </div>

        <div class="bg-gradient-to-br from-slate-50 to-white border border-slate-200 rounded-lg p-6 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-bold uppercase text-stone-500">Logística</p>
                    <h3 class="text-xl font-black mt-1" style="color: var(--guinda);">Traspasos entre Almacenes</h3>
                </div>
                <i class="fas fa-exchange-alt text-3xl" style="color: var(--dorado);"></i>
            </div>
            <button type="button" class="btn btn-sm btn-guinda mt-4 w-full" onclick="App.loadView(event, 'traspasos')">
                Ver Traspasos
            </button>
        </div>

        <div class="bg-gradient-to-br from-emerald-50 to-white border border-emerald-200 rounded-lg p-6 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-bold uppercase text-stone-500">Exportación</p>
                    <h3 class="text-xl font-black mt-1" style="color: var(--guinda);">Reportes y Kardex</h3>
                </div>
                <i class="fas fa-file-excel text-3xl text-emerald-600"></i>
            </div>
            <button type="button" class="btn btn-sm btn-guinda mt-4 w-full" onclick="App.loadView(event, 'reportes')">
                Generar Reportes
            </button>
        </div>
    </div>
</div>