<div class="bg-white rounded-lg shadow-md p-8">
    <div class="border-b border-stone-200 pb-6 mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-blue-50 text-blue-800 mb-2">
                <i class="fas fa-warehouse mr-2" aria-hidden="true"></i>Centro de Operaciones e Inventario
            </span>
            <h2 class="text-2xl font-black text-[#2d2d2d]">Sistema Integral de Gestión de Donaciones</h2>
            <p class="text-stone-600 text-sm mt-1 max-w-2xl">
                Selecciona el módulo de trabajo para registrar entradas de donativos, autorizar salidas a beneficiarios, coordinar traspasos entre almacenes o auditar existencias en tiempo real.
            </p>
        </div>
        <div class="flex items-center gap-2">
            <button type="button" class="btn btn-guinda" onclick="App.loadView(event,'registros')">
                <i class="fas fa-plus-circle mr-1" aria-hidden="true"></i> Nuevo Donativo
            </button>
            <button type="button" class="btn btn-outline-secondary" onclick="App.loadView(event,'consulta')">
                <i class="fas fa-boxes mr-1" aria-hidden="true"></i> Ver Inventario
            </button>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" role="list" aria-label="Módulos del sistema">
        <!-- Card: Nuevo Registro -->
        <button type="button" role="listitem" class="module-launch-card" onclick="App.loadView(event,'registros')">
            <div class="card-icon" style="background: #eff6ff; color: var(--brand-primary);">
                <i class="fas fa-plus-circle" aria-hidden="true"></i>
            </div>
            <span class="text-xs font-bold uppercase tracking-wider text-stone-500 mb-1">Entradas</span>
            <h3 class="text-lg font-bold text-[#2d2d2d] mb-1">Nuevo Registro</h3>
            <p class="text-sm text-stone-600 mb-0">Captura donativos en especie o efectivo, asigna folios e incrementa el stock del almacén.</p>
        </button>

        <!-- Card: Consulta Registros -->
        <button type="button" role="listitem" class="module-launch-card" onclick="App.loadView(event,'consulta')">
            <div class="card-icon" style="background: #f0f9ff; color: var(--brand-accent);">
                <i class="fas fa-search" aria-hidden="true"></i>
            </div>
            <span class="text-xs font-bold uppercase tracking-wider text-stone-500 mb-1">Auditoría y Stock</span>
            <h3 class="text-lg font-bold text-[#2d2d2d] mb-1">Consulta e Inventario</h3>
            <p class="text-sm text-stone-600 mb-0">Busca movimientos por folio o fecha y supervisa existencias y alertas de stock bajo.</p>
        </button>

        <!-- Card: Salidas -->
        <button type="button" role="listitem" class="module-launch-card" onclick="App.loadView(event,'salidas')">
            <div class="card-icon" style="background: #fef2f2; color: #dc2626;">
                <i class="fas fa-box-open" aria-hidden="true"></i>
            </div>
            <span class="text-xs font-bold uppercase tracking-wider text-stone-500 mb-1">Egresos</span>
            <h3 class="text-lg font-bold text-[#2d2d2d] mb-1">Salidas</h3>
            <p class="text-sm text-stone-600 mb-0">Registra entregas a beneficiarios o bajas por merma con descuento automático de inventario.</p>
        </button>

        <!-- Card: Traspasos -->
        <button type="button" role="listitem" class="module-launch-card" onclick="App.loadView(event,'traspasos')">
            <div class="card-icon" style="background: #fffbeb; color: #d97706;">
                <i class="fas fa-arrows-left-right" aria-hidden="true"></i>
            </div>
            <span class="text-xs font-bold uppercase tracking-wider text-stone-500 mb-1">Logística</span>
            <h3 class="text-lg font-bold text-[#2d2d2d] mb-1">Traspasos</h3>
            <p class="text-sm text-stone-600 mb-0">Coordina envíos y recepciones de mercancía entre centros de acopio y almacenes.</p>
        </button>

        <!-- Card: Reportes -->
        <button type="button" role="listitem" class="module-launch-card" onclick="App.loadView(event,'reportes')">
            <div class="card-icon" style="background: #ecfdf5; color: #059669;">
                <i class="fas fa-file-lines" aria-hidden="true"></i>
            </div>
            <span class="text-xs font-bold uppercase tracking-wider text-stone-500 mb-1">Exportación</span>
            <h3 class="text-lg font-bold text-[#2d2d2d] mb-1">Reportes</h3>
            <p class="text-sm text-stone-600 mb-0">Descarga sábanas de entradas, salidas, traspasos e inventario en formato Excel.</p>
        </button>

        <!-- Card: Dashboard -->
        <button type="button" role="listitem" class="module-launch-card" onclick="App.loadView(event,'dashboard')">
            <div class="card-icon" style="background: #f8fafc; color: #334155;">
                <i class="fas fa-chart-line" aria-hidden="true"></i>
            </div>
            <span class="text-xs font-bold uppercase tracking-wider text-stone-500 mb-1">Métricas</span>
            <h3 class="text-lg font-bold text-[#2d2d2d] mb-1">Dashboard</h3>
            <p class="text-sm text-stone-600 mb-0">Consulta indicadores operativos de movimientos activos y estado logístico.</p>
        </button>
    </div>
</div>