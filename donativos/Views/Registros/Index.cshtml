                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                                    </svg>
                                </span>
                                <input type="text" class="form-control" placeholder="Buscar donador" value="" autocomplete="off" id="textDonador">
                            </div>
                        </div>

                        <div class="align-content-md-end col-6">
                            2.Seleccionar donador o guardar nuevo donador.
                            <div class="row">
                                <div class="col-6">

                                    <select class="form-control" id="selectDonador" onchange="telefono($('#selectDonador').val())" required>
                                        <option>--SELECCIONE UNA OPCIÓN--</option>
                                    </select>
                                </div>
                                <div class="col-6">
                                    <button id="btnDonador" type="button" onClick="agregarDonador()" class="btn btn-secondary">Guardar donador</button>
                                </div>
                            </div>

                        </div>
                    </div>
                    
                    <div class="invalid-feedback">
                        Este dato es requerido.
                    </div>
                </div>
                <hr style="padding: 1px;" />


                <div class="row">
                    <div class="col">
                        <label for="textTelefono"><b>Telefono</b>:</label>
                        <input type="number" class="form-control" id="textTelefono" placeholder="Telefono" value="" min="10" maxlength="10">
                    </div>

                    <div class="col">
                        <label for="textCorreo"><b>Correo electrónico</b>:</label>
                        <input type="email" class="form-control" id="textCorreo" placeholder="Correo" value="">
                    </div>

                    <div class="col">
                        <label for="selectTipoDonador"><b>Tipo Donador</b>:</label>
                        <select class="form-control" id="selectTipoDonador">
                            <option value="0">--SELECCIONE UNA OPCIÓN--</option>
                            <option value="1">FAMILIAS</option>
                            <option value="2">ESCUELAS</option>
                            <option value="3">MUNICIPIOS</option>
                            <option value="4">GOBIERNO</option>
                            <option value="5">SOCIEDAD CIVIL</option>
                            <option value="6">EMPRESAS</option>
                        </select>
                    </div>

                </div>

                <hr style="padding: 10px;" />

                <div class="row">
                    <label for="textArticulo">*<b title="Es la descripción del donativo que se entrega en el centro de acopio.">Artículo</b>:</label>

                    <div class="col">
                        1.Buscar articulo.
                        <div class="input-group w-100">
                            <span class="input-group-text" id="basic-addon1">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                                </svg>
                            </span>
                            <input type="text" class="form-control" id="textArticulo" placeholder="Buscar artículo" value="" autocomplete="off">
                        </div>
                    </div>
                    <div class="col">
                        2.Seleccionar articulo
                        <select class="form-control" id="selectArticulo" required>
                            <option>--SELECCIONE UNA OPCIÓN--</option>
                            <option>Agua Embotellada de 1.5 lts gua Embotellada de 1.5 lts</option>
                            <option>Papel Higienico</option>
                            <option>Cobijas</option>
                            <option>Jabón Detergente 2 Kgs</option>


                        </select>

                        <div class="invalid-feedback">
                            Este dato es requerido.
                        </div>
                    </div>
                    <div class="col">
                        3.Seleccionar Categoria
                        <select class="form-control" id="selectCategoria" required>
                            <option value="0">--SELECCIONE UNA OPCIÓN--</option>
                            <option value="1">Alimentos y Agua potable </option>
                            <option value="2">Artículos de Higiene Personal y Saneamiento </option>
                            <option value="3">Medicamentos y primeros Auxilios </option>
                            <option value="4">Artículos de Emergencia y Supervivencia </option>
                            <option value="5">Herramientas</option>
                            <option value="6">Material de Desinfección </option>
                            <option value="7">Cobijas</option>
                            <option value="8">Alimento para Mascota</option>
                            <option value="9">Ropa</option>
                            <option value="10">Agua potable </option>
                            <option value="11">Alimentos</option>
                            <option value="12">Otros</option>
                        </select>
                    </div>
                    <div class="col">
                        4.Si no existe, guardar Art.
                        <button id="btnArticulo" type="button" class="btn btn-secondary" onclick="agregarArticulo()">Guardar artículo</button>
                    </div>
                </div>
                <hr style="padding: 1px;" />
                <div class="row">
                    <div class="col-7">
                        <label for="selectUnidadMedida">*<b title="Es la presentación de cómo se entrega el artículo.">Unidad de medida</b>: <i></i></label><br />
                        <!--input type="text" class="form-control" id="textUnidadMedida" placeholder="Buscar unidad de medida" value="" required-->
                        1.Buscar Unidad
                        <div class="input-group w-100">

                            <span class="input-group-text" id="basic-addon1">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                                </svg>
                            </span>
                            <input type="text" class="form-control" id="textUnidadMedida" placeholder="Buscar unidad de medida" value="" autocomplete="off">
                        </div>
                        2. Seleccionar Unidad
                        <select class="form-control" id="selectUnidadMedida" onchange="calculo()" required>
                            <option>--SELECCIONE UNA OPCIÓN--</option>
                            <option>Bolsa</option>
                            <option>Bote</option>
                            <option>Botella</option>
                            <option>Caja</option>
                            <option>Costal</option>
                            <option>Dosis</option>
                            <option>Frasco</option>
                            <option>Kilogramos</option>
                            <option>Litro</option>
                            <option>Metro cuadrado</option>
                            <option>Metro cubico</option>
                            <option>Metro lineal</option>
                            <option>Paquete</option>
                            <option>Pieza</option>
                            <option>Ración</option>
                            <option>Tonelada</option>
                            <option>No aplica</option>
                        </select>
                        3. Guardar solo si no existe.
                        <button id="btnUniMed" onclick="agregarUniMed()" type="button" class="btn btn-secondary">Guardar unidad de medida</button>

                        <div class="invalid-feedback">
                            Este dato es requerido.
                        </div>
                    </div>
                    <div class="col-5">
                        <label for="textCantidadPza">*<b title="Es la cantidad de piezas que contiene la presentación (unidad de medida) seleccionada.">Cantidad por unidad de medida</b>: <i></i></label>
                        <br />
                        <input type="number" class="form-control" id="textCantidadPza" placeholder="Cantidad" value="0" step="any" onkeyup="calculo()" required>
                        <div class="invalid-feedback">
                            Este dato es requerido.
                        </div>
                    </div>
                </div>
                <hr style="padding: 1px;" />
                <div class="row">
                    <div class="col-7">
                        <label for="textCantidad">*<b title="Es el número de elementos que conforman la unidad de medida seleccionada.">Cantidad</b>: <i></i></label>
                        <input type="number" class="form-control" id="textCantidad" placeholder="Cantidad" value="0" step="any" onkeyup="calculo()" required>
                        <div class="invalid-feedback">
                            Este dato es requerido.
                        </div>
                    </div>
                    <div class="col-5">
                        <br />
                        <h2><b><label for="textArticulo" style="background-color:cornflowerblue; color:#fff" id="lblCT"></label></b></h2>
                    </div>
                </div>

                <hr style="padding: 10px;" />

                <div class="row">
                    <div class="col-9">
                        <label for="textKiloPieza"><b>Kilos por pieza</b>:</label>
                        <input type="number" class="form-control" id="textKiloPieza" placeholder="Kilos" value="" step="any">
                        <div class="invalid-feedback">
                            Este dato es requerido.
                        </div>
                    </div>

                    <div class="col-3">

                        <label for="textLitroPieza"><b>Litros por pieza</b>:</label>
                        <input type="number" class="form-control" id="textLitroPieza" placeholder="Litros" value="" step="any">
                        <div class="invalid-feedback">
                            Este dato es requerido.
                        </div>

                    </div>

                </div>
                <div class="row">
                    <div class="col">

                        <label for="textObs"><b>Observaciones</b>:</label>
                        <input type="text" class="form-control" id="textObs" placeholder="observaciones" value="">
                        <div class="invalid-feedback">
                            Este dato es requerido.
                        </div>


                        <div class="invalid-feedback">
                            Este dato es requerido.
                        </div>
                    </div>
                </div>

                <hr class="my-4">

                <button class="w-100 btn btn-primary btn-lg" type="submit" id="guardar">GUARDAR INFORMACIÓN</button>

            </form>



            <hr style="padding: 10px; color:red" />

            <div class="py-5 text-center">
                <h2>Consulta de registros</h2>

            </div>



            <div class="form-group">
                <label for="textBuscarArt">*<b>Buscar por artículo</b>:</label>

                <input type="text" class="form-control" id="textBuscarArt" placeholder="Buscar por artículo" value="" onkeyup="buscarArt($('#textBuscarArt').val())">
                <div class="invalid-feedback">
                    Este dato es requerido.
                </div>
            </div>

            <div class="form-group">
                <label for="textBuscarDon">*<b>Buscar por donandor</b>:</label>

                <input type="text" class="form-control" id="textBuscarDon" placeholder="Buscar por donador" value="" onkeyup="buscarDon($('#textBuscarDon').val())">
                <div class="invalid-feedback">
                    Este dato es requerido.
                </div>
            </div>



            <div class="container" style="padding-top:50px">

                <table class="table table-striped" id="registro">
                    <thead>
                        <tr>
                            <th></th>
                            <th></th>
                            <th id="folio" style="cursor:pointer;text-decoration:underline" onclick="if (orden === 'ASC' && llave === 'folio') {ordenarDesc(json,'folio') } else {ordenarAsc(json,'folio') }">Folio</th>
                            <th id="fecha" style="cursor:pointer;text-decoration:underline" onclick="if (orden === 'ASC' && llave === 'fecha') {ordenarDesc(json,'fecha') } else {ordenarAsc(json,'fecha') }">Fecha</th>
                            <th id="donador" style="cursor:pointer;text-decoration:underline" onclick="if (orden === 'ASC' && llave === 'donador') {ordenarDesc(json,'donador') } else {ordenarAsc(json,'donador') }">Donador</th>
                            <th id="articulo" style="cursor:pointer;text-decoration:underline" onclick="if (orden === 'ASC' && llave === 'articulo') {ordenarDesc(json,'articulo') } else {ordenarAsc(json,'articulo') }">Artículo</th>
                            <th id="unidadMedida" style="cursor:pointer;text-decoration:underline" onclick="if (orden === 'ASC' && llave === 'unidadMedida') {ordenarDesc(json,'unidadMedida') } else {ordenarAsc(json,'unidadMedida') }">U. Medida</th>
                            <th id="cantidad" style="cursor:pointer;text-decoration:underline" onclick="if (orden === 'ASC' && llave === 'cantidad') {ordenarDesc(json,'cantidad') } else {ordenarAsc(json,'cantidad') }">Cantidad</th>
                            <th id="kiloPorPieza" style="cursor:pointer;text-decoration:underline" onclick="if (orden === 'ASC' && llave === 'kiloPorPieza') {ordenarDesc(json,'kiloPorPieza') } else {ordenarAsc(json,'kiloPorPieza') }">Kg/Pza</th>
                            <th id="litroPorPieza" style="cursor:pointer;text-decoration:underline" onclick="if (orden === 'ASC' && llave === 'litroPorPieza') {ordenarDesc(json,'litroPorPieza') } else {ordenarAsc(json,'litroPorPieza') }">Lt/Pza</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
            <div class="scrollmenu">
                <table id="paginacion">
                </table>
            </div>




        </main>

        <footer class="my-5 pt-5 text-muted text-center text-small">
            <p class="mb-1">Sistema DIF Hidalgo</p>
