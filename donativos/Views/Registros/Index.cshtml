                $("#registro>thead>tr>th")[a].style.backgroundColor = 'white'
            })
            var d = '';
            var array2 = new Array()
            var cantidad = 0
            for (var i = 0; i < json.length; i += 10) {
                cantidad += 1
                array2.push(cantidad)
            }
            var cantidad2 = json.length
            var cantidad3 = json.length
            if (cantidad3 > 10)
                cantidad3 = 10
            $("#registro > tbody").empty()
            $("#paginacion").empty()
            for (var i = 0; i < cantidad3; i++) {
                if (json[i].sincronizado === false) {
                    d += '<tr>' +
                        '<td> <input type="button" onclick="modificar(' + json[i].folio + ')" value="Modificar"/></td>' +
                        '<td> <input type="button" onclick="eliminar(' + json[i].folio + ')" value="Eliminar"/></td>' +
                        '<td>' + json[i].folio + '</td>' +
                        '<td>' + new Date(json[i].fecha).toLocaleDateString("en-GB") + '</td>' +
                        '<td>' + json[i].donador + '</td>' +
                        '<td>' + json[i].articulo + '</td>' +
                        '<td>' + json[i].unidadMedida + '</td>' +
                        '<td>' + json[i].cantidad + '</td>' +
                        '<td>' + json[i].kiloPorPieza + '</td>' +
                        '<td>' + json[i].litroPorPieza + '</td></tr>'
                }
            }
            var e = ''
            if (cantidad2 > 10) {
                for (var i = 0; i < array2.length; i++) {
                    e += "<td id='paginacion'><input id='pag" + array2[i] + "' value='" + array2[i] + "' onclick='cambiarPagina(" + array2[i] + ")' type='button'/></td>"
                }
            }
            $("#paginacion").append(e)
            $("#registro > tbody").append(d)
        })
        function eliminar(id) {
            var respuesta = confirm("Esta seguro de eliminar el registro")

            if (respuesta) {
                  $.ajax({
                type: 'GET',
                url: '@Url.Action("eliminar", "Registros")',
                dataType: 'json',
                      data: { id: id, a : '@ViewBag.a'},
                      success: function (resultado) {
