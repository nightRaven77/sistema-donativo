    <title>DIF Hidalgo</title>

    <!-- Bootstrap core CSS -->
    <link href="~/assets/dist/css/bootstrap.min.css" rel="stylesheet" asp-append-version="true">
        <!-- Tailwind CSS -->
        <link href="~/css/tailwind.min.css" rel="stylesheet" asp-append-version="true">
            <!-- FontAwesome -->
            <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
            <!-- jQuery 3.4.0 (una sola versión) -->
            <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.4.0/jquery.min.js"></script>
            <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.1/jquery.validate.min.js"></script>
            <script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>
            <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
            <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet">
            <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

            <!-- ⭐ Scripts locales con cache busting automático (asp-append-version="true") -->
            <!-- Servicio AJAX centralizado -->
            <script src="~/Scripts/ajax-service.js" asp-append-version="true"></script>
            <!-- Servicio de Notificaciones Unificado -->
            <script src="~/Scripts/notificaciones-service.js" asp-append-version="true"></script>
            <!-- ⭐ Manejador centralizado de errores AJAX (debe cargarse antes de los módulos) -->
            <script src="~/Scripts/error-handler.js" asp-append-version="true"></script>
            <!-- Scripts de módulos -->
            <script src="~/Scripts/logger.js" asp-append-version="true"></script>
            <script src="~/Scripts/registros.js" asp-append-version="true"></script>
            <script src="~/Scripts/salidas.js" asp-append-version="true"></script>
            <script src="~/Scripts/traspasos.js" asp-append-version="true"></script>
            <script src="~/Scripts/reportes.js" asp-append-version="true"></script>
            <script src="~/Scripts/consulta.js" asp-append-version="true"></script>
            <link href="~/Scripts/styles.css" rel="stylesheet" asp-append-version="true" />
            <link rel="icon" type="image/x-icon" href="~/assets/imagenes/favicon.ico">

                <!-- Scripts necesarios -->
                <link href="https://cdn.jsdelivr.net/npm/table-js-simple@1.0.0/table.css" rel="stylesheet">
                <script src="https://cdn.jsdelivr.net/npm/table-js-simple@1.0.0/table.min.js"></script>

                <!-- DataTables CSS -->
                <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css">
                <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css">

                <!-- DataTables JS -->
                <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
                <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
                <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
                <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>


            </head>
            <body class="bg-stone-50">

                <!-- Loading Spinner -->
                <div class="loading" id="loadingSpinner">
                    <div class="spinner-wrapper">
                        <div class="spinner-icon"></div>
                        <div class="spinner-text">Cargando</div>
                        <div class="spinner-subtext" id="spinnerText">Por favor espera...</div>
                    </div>
                </div>

                <div class="flex min-h-screen">
                    <!-- Sidebar -->
                    <aside class="w-64 bg-[#2d2d2d] text-white flex-shrink-0 shadow-xl fixed h-full z-50">
                        <div class="sidebar-header">
                            <img src="~/assets/imagenes/logodif.png" alt="DIF Hidalgo" class="w-full">
                                <p class="text-[10px] text-stone-400 uppercase mt-2 italic font-semibold">Hidalgo Solidario</p>
                            </div>

                            <nav class="sidebar-nav">
                                <a href="#" onclick="App.loadView(event, 'inicio'); return false;" class="sidebar-item active-tab flex items-center px-6 py-4 transition-all">
                                    <i class="fas fa-home w-6" style="color:var(--dorado)"></i>
                                    <span class="ml-3">Inicio</span>
                                </a>
                                <a href="#" onclick="App.loadView(event, 'registros'); return false;" class="sidebar-item flex items-center px-6 py-4 transition-all">
                                    <i class="fas fa-plus-circle w-6" style="color:var(--dorado)"></i>
                                    <span class="ml-3">Nuevo Registro</span>
                                </a>
                                <a href="#" onclick="App.loadView(event, 'consulta'); return false;" class="sidebar-item flex items-center px-6 py-4 transition-all">
                                    <i class="fas fa-search w-6"></i>
                                    <span class="ml-3">Consulta Registros</span>
                                </a>
                                <div class="px-6 py-2 text-[10px] text-stone-500 uppercase font-black mt-4">Operaciones</div>
                                <a href="#" onclick="App.loadView(event, 'salidas'); return false;" class="sidebar-item flex items-center px-6 py-4 transition-all">
                                    <i class="fas fa-arrow-up w-6"></i>
                                    <span class="ml-3">Salidas</span>
                                </a>
                                <a href="#" onclick="App.loadView(event, 'traspasos'); return false;" class="sidebar-item flex items-center px-6 py-4 transition-all">
                                    <i class="fa-solid fa-arrows-h w-6"></i>
                                    <span class="ml-3">Traspasos</span>
                                </a>
                                <a href="#" onclick="App.loadView(event, 'reportes'); return false;" class="sidebar-item flex items-center px-6 py-4 transition-all">
                                    <i class="fa-solid fa-file-text"></i>
                                    <span class="ml-3">Reportes</span>
                                </a>
                                <a href="#" onclick="App.loadView(event, 'dashboard'); return false;" class="sidebar-item flex items-center px-6 py-4 transition-all">
                                    <i class="fas fa-chart-line w-6"></i>
                                    <span class="ml-3">Dashboard</span>
                                </a>
                                <div class="px-6 py-2 text-[10px] text-stone-500 uppercase font-black mt-4">Sistema</div>
                                <form action="@Url.Action("CerrarSesion", "Registros")" method="post" style="margin: 0;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="sidebar-item flex items-center px-6 py-4 transition-all text-red-400 hover:text-red-300 w-full text-left border-0 bg-transparent cursor-pointer">
                                        <i class="fas fa-sign-out-alt w-6"></i>
                                        <span class="ml-3">Cerrar Sesión</span>
                                    </button>
                                </form>
                            </nav>
                        </aside>

                        <!-- Main Content -->
                        <main class="flex-1 p-8">
                            <!-- Header -->
                            <div class="mb-8 flex justify-between items-center">
                                <div>
                                    <h1 class="text-4xl font-black text-[#2d2d2d] mb-1">Centro de Recepción</h1>
                                    <p class="text-stone-600 text-lg"><span style="color:var(--dorado); font-weight:bold;">@ViewBag.centro</span></p>
                                    <p class="text-stone-600 text-lg"><span style="color:var(--dorado); font-weight:bold;">@ViewBag.usuario</span></p>
                                </div>
                            </div>

                            <!-- Dynamic Content Container -->
                            <div id="contentContainer"></div>
                        </main>
                    </div>

                    <script src="~/assets/dist/js/bootstrap.bundle.min.js"></script>
                    <script>
                        // Variables globales de sesión del usuario
                        const usuarioSession = {
                        centroID: '@Context.Session.GetString("CentroID")'
                        // usuario: '@Context.Session.GetString("usuario")',
                        // centroAcopio: '@Context.Session.GetString("centroAcopio")',
                        // token: '@Context.Session.GetString("token")'
                        };

                        // console.log('Información de sesión cargada:', usuarioSession);

                        // Configurar Toastr
                        toastr.options = {
                        "closeButton": true,
                        "debug": false,
                        "newestOnTop": true,
                        "progressBar": true,
                        "positionClass": "toast-top-right",
                        "preventDuplicates": true,
                        "onclick": null,
                        "showDuration": 300,
                        "hideDuration": 1000,
                        "timeOut": 5000,
                        "extendedTimeOut": 1000,
                        "showEasing": "swing",
                        "hideEasing": "linear",
                        "showMethod": "fadeIn",
                        "hideMethod": "fadeOut"
                        };

                        // Aplicación SPA Principal
                        const App = {
                        currentView: 'inicio',
                        bodegaId: '@ViewBag.a',
                        viewTitles: {
                        'inicio': 'Cargando página de inicio',
                        'registros': 'Cargando formulario de registro',
                        'consulta': 'Cargando consulta de registros',
                        'salidas': 'Cargando salidas',
                        'traspasos': 'Cargando traspasos',
                        'reportes': 'Cargando reportes',
                        'dashboard': 'Cargando dashboard'
                        },

                        init() {
                        this.loadViewInternal('inicio');
                        },

                        loadView(event, viewName) {
                        event?.preventDefault();

                        // Actualizar sidebar
                        document.querySelectorAll('.sidebar-item').forEach(item => {
                        item.classList.remove('active-tab');
                        });
                        event?.target?.closest('.sidebar-item')?.classList.add('active-tab');

                        this.loadViewInternal(viewName);
                        },

                        loadViewInternal(viewName) {
                        const container = document.getElementById('contentContainer');
                        const loader = document.getElementById('loadingSpinner');
                        const spinnerText = document.getElementById('spinnerText');

                        // ⭐ LIMPIAR DATATABLES ANTES DE CAMBIAR DE VISTA
                        if (typeof dataTableSalidas !== 'undefined' && dataTableSalidas !== null) {
                        console.log('🧹 Destruyendo DataTable Salidas');
                        dataTableSalidas.destroy();
                        dataTableSalidas = null;
                        }
                        if (typeof dataTableTraspasos !== 'undefined' && dataTableTraspasos !== null) {
                        console.log('🧹 Destruyendo DataTable Traspasos');
                        dataTableTraspasos.destroy();
                        dataTableTraspasos = null;
                        }
                        if (typeof tablaMovimientos !== 'undefined' && tablaMovimientos !== null) {
                        console.log('🧹 Destruyendo DataTable Movimientos (Consulta)');
                        tablaMovimientos.destroy();
                        tablaMovimientos = null;
                        }
                        if (typeof tablaInventario !== 'undefined' && tablaInventario !== null) {
                        console.log('🧹 Destruyendo DataTable Inventario (Consulta)');
                        tablaInventario.destroy();
                        tablaInventario = null;
                        }

                        // Actualizar texto del spinner
                        spinnerText.textContent = this.viewTitles[viewName] || 'Por favor espera...';

                        // Mostrar loader
                        loader.classList.add('active');

                        $.ajax({
                        type: 'GET',
                        url: '@Url.Action("GetView", "Registros")',
                        data: { viewName: viewName, a: this.bodegaId },
                        success: (html) => {
                        loader.classList.remove('active');
                        container.innerHTML = html;
                        this.currentView = viewName;
                        $("html,body").animate({ scrollTop: 0 }, 300);

                        // Marcar como activa la opción del menú correspondiente
                        this.updateActiveMenu(viewName);

                        // ⭐ INICIALIZAR MÓDULOS SEGÚN LA VISTA CARGADA
                        if (viewName === 'registros') {
                        if (typeof initRegistrosForm === 'function') {
                        initRegistrosForm();
                        }

                        setTimeout(() => {
                        document.dispatchEvent(new Event('registrosViewLoaded'));
                        }, 100);
                        } else if (viewName === 'salidas') {
                        // Inicializar módulo de salidas
                        if (typeof inicializarSalidas === 'function') {
                        console.log('🚀 Inicializando módulo Salidas');
                        // ⭐ Esperar a que el DOM esté completamente renderizado
                        setTimeout(() => {
                        inicializarSalidas();
                        }, 300);
                        }
                        } else if (viewName === 'traspasos') {
                        // Inicializar módulo de traspasos
                        if (typeof inicializarTraspasos === 'function') {
                        console.log('🚀 Inicializando módulo Traspasos');
                        // ⭐ Esperar a que el DOM esté completamente renderizado
                        setTimeout(() => {
                        inicializarTraspasos();
                        }, 300);
                        }
                        } else if (viewName === 'reportes') {
                        // Inicializar módulo de reportes
                        if (typeof inicializarReportes === 'function') {
                        console.log('🚀 Inicializando módulo Reportes');
                        // ⭐ Esperar a que el DOM esté completamente renderizado
                        setTimeout(() => {
                        inicializarReportes();
                        }, 300);
                        }
                        } else if (viewName === 'consulta') {
                        // Inicializar módulo de consulta
                        if (typeof inicializarConsulta === 'function') {
                        console.log('🚀 Inicializando módulo Consulta');
                        // ⭐ Esperar a que el DOM esté completamente renderizado
                        setTimeout(() => {
                        inicializarConsulta();
                        }, 300);
                        }
                        }
                        },
                        error: (xhr, status, error) => {
                        loader.classList.remove('active');
                        toastr.error('Error al cargar la vista: ' + error, 'Error');
                        console.error(error);
                        }
                        });
                        },

                        updateActiveMenu(viewName) {
                        const menuItems = {
                        'inicio': 0,
                        'registros': 1,
                        'consulta': 2,
                        'salidas': 3,
                        'traspasos': 4,
                        'reportes': 5,
                        'dashboard': 6
                        };

                        const items = document.querySelectorAll('.sidebar-nav .sidebar-item');
                        items.forEach((item, index) => {
                        item.classList.remove('active-tab');
                        if (menuItems[viewName] === index) {
                        item.classList.add('active-tab');
                        }
                        });
                        }
                        };

                        // Inicializar aplicación al cargar
                        $(document).ready(() => {
                        App.init();
                        });
                    </script>
                </body>
            </html>
