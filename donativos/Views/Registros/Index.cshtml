        function cambiarPagina(p) {
            $("#registro > tbody").empty();
            var cantidad = p * 10
            var d = '';
            if (json.length < cantidad)
                cantidad = json.length
            var cantidad2 = 0
            var array2 = new Array()
            for (var i = 0; i < json.length; i += 10) {
                cantidad2 += 1
                array2.push(cantidad2)
            }

            for (var i = p * 10 - 10; i < cantidad; i++) {
                if (json[i].sincronizado === false) {
                    d += '<tr>' +
                        '<td> <input type="button" onclick="modificar(' + json[i].folio + ')" value="Modificar"/></td>' +
                        '<td> <input type="button" onclick="eliminar(' + json[i].folio + ')" value="Eliminar"/></td>' +
                        '<td>' + json[i].folio + '</td>' +
                        '<td>' + new Date(json[i].fecha).toLocaleDateString("en-GB") + '</td>' +
                        '<td>' + json[i].donador + '</td>' +
                        '<td>' + json[i].articulo + '</td>' +
                        '<td>' + json[i].unidadMedida + '</td>' +
                        '<td>' + json[i].cantidad + '</td>' +
                        '<td>' + json[i].kiloPorPieza + '</td>' +
                        '<td>' + json[i].litroPorPieza + '</td></tr>'
                }
            }

            $("#registro > tbody").append(d)
        }
        function ordenarAsc(p_array_json, p_key) {
            p_array_json.sort(function (a, b) {
                return a[p_key] > b[p_key] ? 1 : a[p_key] < b[p_key] ? -1 : 0;
            });
            llave = p_key
            orden = 'ASC'
            $.each($("#registro>thead>tr>th"), function (a) {
                $("#registro>thead>tr>th")[a].style.backgroundColor = 'white'
            })
            $("#registro>thead>tr>th[id='" + p_key + "']").css('background-color', 'lightpink')
            cambiarPagina(1)
        }
        function ordenarDesc(p_array_json, p_key) {
            ordenarAsc(p_array_json, p_key); p_array_json.reverse();
            orden = 'DESC'
            cambiarPagina(1)
        }
