                     $("#selectDonador").val(JSON.parse(arti).donadorID)
                     $("#selectArticulo").val(JSON.parse(arti).articuloID)
                     $("#selectUnidadMedida").val(JSON.parse(arti).unidadMedidaID)
                     $("#textCantidad").val(JSON.parse(arti).cantidad)
                     $("#textLitroPieza").val(JSON.parse(arti).litroPorPieza)
                     $("#textKiloPieza").val(JSON.parse(arti).kiloPorPieza)
                     $("#textCantidadPza").val(JSON.parse(arti).cantidadPorArticulo)
                     $("#textObs").val(JSON.parse(arti).observacion)
                     console.log(JSON.parse(arti))
                     $("html,body").animate({ scrollTop:0 },500)

                }, error: function (ex) {
