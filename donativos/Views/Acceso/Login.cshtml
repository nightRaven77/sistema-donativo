@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Sistema de Donativos</title>
    <link href="~/assets/dist/css/login.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <link rel="icon" type="image/x-icon" href="~/assets/imagenes/favicon.ico">
</head>
<body>
    <div class="login-wrapper">
        <!-- Background Decoration -->
        <div class="background-shapes" aria-hidden="true">
            <div class="shape shape-1"></div>
            <div class="shape shape-2"></div>
            <div class="shape shape-3"></div>
        </div>

        <!-- Main Container -->
        <main class="login-main-container">
            <!-- Left Side - Branding -->
            <div class="login-branding">
                <div class="branding-content animate-fade-in-left">
                    <div class="logo-container">
                        <img src="~/assets/imagenes/logo.png" alt="Logotipo del Sistema de Donativos" class="logo-image">
                    </div>
                    <p class="branding-subtitle">Sistema Integral de Gestión de Donaciones</p>
                    
                    <div class="branding-features">
                        <div class="feature-item">
                            <i class="fas fa-shield-alt" aria-hidden="true"></i>
                            <span>Seguro y Confiable</span>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-tachometer-alt" aria-hidden="true"></i>
                            <span>Rápido y Eficiente</span>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-users" aria-hidden="true"></i>
                            <span>Gestión Colaborativa</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Side - Form -->
            <div class="login-form-container">
                <form action="@Url.Action("Login", "Acceso")" method="post" class="login-form animate-fade-in-right" id="loginForm">
                    @Html.AntiForgeryToken()
                    <div class="form-header">
                        <h1>Bienvenido</h1>
                        <p>Ingresa tus credenciales para acceder al centro de operaciones</p>
                    </div>

                    <div class="form-group">
                        <label for="username" class="form-label">
                            <i class="fas fa-user" aria-hidden="true"></i> Usuario
                        </label>
                        <input type="text" id="username" name="username" class="form-input" placeholder="Tu usuario" autocomplete="username" required>
                        <span class="input-focus-border"></span>
                    </div>

                    <div class="form-group">
                        <label for="password" class="form-label">
                            <i class="fas fa-lock" aria-hidden="true"></i> Contraseña
                        </label>
                        <div class="password-wrapper">
                            <input type="password" id="password" name="password" class="form-input" placeholder="Tu contraseña" autocomplete="current-password" required>
                            <button type="button" class="toggle-password" onclick="togglePassword()" aria-label="Mostrar u ocultar contraseña" aria-pressed="false">
                                <i class="fas fa-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                        <span class="input-focus-border"></span>
                    </div>

                    <button type="submit" class="btn-login">
                        <span>Iniciar Sesión</span>
                        <i class="fas fa-arrow-right" aria-hidden="true"></i>
                    </button>

                    <div class="form-footer">
                        <p>&copy; @DateTime.Now.Year Sistema de Donativos. Todos los derechos reservados.</p>
                    </div>
                </form>
            </div>
        </main>
    </div>

    <script>
        // Configurar Toastr
        toastr.options = {
            "closeButton": true,
            "debug": false,
            "newestOnTop": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "preventDuplicates": true,
            "onclick": null,
            "showDuration": 300,
            "hideDuration": 1000,
            "timeOut": 5000,
            "extendedTimeOut": 1000,
            "showEasing": "swing",
            "hideEasing": "linear",
            "showMethod": "fadeIn",
            "hideMethod": "fadeOut"
        };

        function togglePassword() {
            const passwordInput = document.getElementById('password');
            const toggleButton = document.querySelector('.toggle-password');
            const toggleIcon = document.querySelector('.toggle-password i');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.classList.remove('fa-eye');
                toggleIcon.classList.add('fa-eye-slash');
                toggleButton?.setAttribute('aria-pressed', 'true');
            } else {
                passwordInput.type = 'password';
                toggleIcon.classList.remove('fa-eye-slash');
                toggleIcon.classList.add('fa-eye');
                toggleButton?.setAttribute('aria-pressed', 'false');
            }
        }

        // Agregar clase active al hacer focus en los inputs
        document.querySelectorAll('.form-input').forEach(input => {
            input.addEventListener('focus', function() {
                this.parentElement.classList.add('focused');
            });
            input.addEventListener('blur', function() {
                this.parentElement.classList.remove('focused');
            });
        });

        // Manejar el envío del formulario
        document.getElementById('loginForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const username = document.getElementById('username').value.trim();
            const password = document.getElementById('password').value.trim();

            if (!username || !password) {
                toastr.warning('Por favor completa todos los campos', 'Campos requeridos');
                return;
            }

            // Enviar el formulario si la validación pasa
            this.submit();
        });

        // Mostrar notificaciones si vienen del servidor (opcional)
        @if (ViewBag.MensajeError != null)
        {
            <text>toastr.error(@Html.Raw(Json.Serialize(ViewBag.MensajeError.ToString())), 'Error de Login');</text>
        }

        @if (ViewBag.MensajeExito != null)
        {
            <text>toastr.success(@Html.Raw(Json.Serialize(ViewBag.MensajeExito.ToString())), 'Éxito');</text>
        }
    </script>
</body>
</html>
