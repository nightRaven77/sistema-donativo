    <script>
        var json = new Array();
        $(function () {

            //se obtiene seleccion de busqueda de donador
          $("#textDonador").keyup(function () {
              if ($("#textDonador").val().length <= 0){
                  $("#selectDonador").empty();
                  $("#selectDonador").append('<option value="0">--SELECCIONE UNA OPCIÓN--</option>');
              }
              else{
                  $.ajax({
                type: 'GET',
                url: '@Url.Action("donador", "Registros")',
                dataType: 'json',
                      data: {a : '@ViewBag.a' , text: $("#textDonador").val()},
                      success: function (resultado) {
                          //console.log(resultado)
                          if (resultado === '"No se encontraron donadores"'){
                               $("#selectDonador").empty();
                               $("#selectDonador").append('<option value="0">--SELECCIONE UNA OPCIÓN--</option>');
                          }
                          else {
                              $("#selectDonador").empty();
                              $.each(JSON.parse(resultado), function (i, arti) {
                                  $("#selectDonador").append('<option value="' + arti.donadorID + '">' + arti.nombre + '</option>');
                              });
                          }
                }, error: function (ex) {
                }
            })}
            })

          $("#exportar").click(function () {
              // antes de /Reportes/generaReporte en la publicacion se agrega el nombre del la app publicada, por ejemplo /contingencia2024/Reportes/generaReporte
              // param trabajar localmente es sin el nombre de la publicacin
              if (document.getElementById('listado').checked) {
                  window.location =
                        "generaReporte?opcion=1&fechaInicio=" +
                      $("#txtFecInicio").val() +
                      "&fechaFinal=" +
                      $("#txtFecFinal").val() +
                      "&donador=" +
                      $("#selectDonador").val() +
                      "&centro=" +
                      $("#centroAcopio").val();
              } else if (document.getElementById('totales').checked) {
                  window.location =
                        "generaReporte?opcion=2&fechaInicio=" +
                      $("#txtFecInicio").val() +
                      "&fechaFinal=" +
                      $("#txtFecFinal").val() +
                      "&donador=" +
                        $("#selectDonador").val() +
                        "&centro=" +
                        $("#centroAcopio").val();
              } else if (document.getElementById('donadores').checked) {
                  window.location =
                        "generaReporte?opcion=3&fechaInicio=" +
                      $("#txtFecInicio").val() +
                      "&fechaFinal=" +
                      $("#txtFecFinal").val() +
                      "&donador=" +
                        $("#selectDonador").val() +
                        "&centro=" +
                        $("#centroAcopio").val();
              }else if (document.getElementById('categoria').checked) {
                  window.location =
                        "generaReporte?opcion=4&fechaInicio=" +
                      $("#txtFecInicio").val() +
                      "&fechaFinal=" +
                      $("#txtFecFinal").val() +
                      "&donador=" +
                        $("#selectDonador").val() +
                        "&centro=" +
                        $("#centroAcopio").val();
              }
              else if (document.getElementById('fecha').checked) {
                  window.location =
                        "generaReporte?opcion=5&fechaInicio=" +
                      $("#txtFecInicio").val() +
                      "&fechaFinal=" +
                      $("#txtFecFinal").val() +
                      "&donador=" +
                        $("#selectDonador").val() +
                        "&centro=" +
                        $("#centroAcopio").val();
              }
              else if (document.getElementById('centro').checked) {
                  window.location =
                        "generaReporte?opcion=6&fechaInicio=" +
                      $("#txtFecInicio").val() +
                      "&fechaFinal=" +
                      $("#txtFecFinal").val() +
                      "&donador=" +
                        $("#selectDonador").val() +
                        "&centro=" +
                        $("#centroAcopio").val();
              }
            //   else if (document.getElementById('mensajeCategorias').checked){
            //     $.ajax({
            //     type: 'GET',
            //     url: '@Url.Action("generaMensaje", "Reportes")',
            //     dataType: 'json',
            //           data: {opcion: 7, fechaInicio: $("#txtFecInicio").val(), fechaFinal: $("#txtFecFinal").val(), donador:  $("#selectDonador").val(), centro: $("#centroAcopio").val() },
            //           success: function (resultado) {
            //               //console.log(resultado)
            //               if (resultado === '""'){

            //               }
            //               else {
                             
            //                       swal("Mensaje", resultado,"info");
            //               }
            //     }, error: function (ex) {
            //     }
            // })

            //   }
              else if (document.getElementById('mensajeDonadores').checked){
                $.ajax({
                type: 'GET',
                url: '@Url.Action("generaMensaje", "Reportes")',
                dataType: 'json',
                      data: {opcion: 8, fechaInicio: $("#txtFecInicio").val(), fechaFinal: $("#txtFecFinal").val(), donador:  $("#selectDonador").val(), centro: $("#centroAcopio").val() },
                      success: function (resultado) {
                          //console.log(resultado)
                          if (resultado === '""'){

                          }
                          else {

                                  swal("Mensaje", resultado,"info");
                          }
                }, error: function (ex) {
                }
            })

              }
              else {
                  swal("Error", "Por favor selecciona un tipo de Reporte", "error");
              }

          });
        });


        $(document).ready(function () {
            json = JSON.parse(@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.json)))

            //Se muestra listado general de donadores
            var Don = JSON.parse(@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Don)))
            $("#selectDonador").empty();
            $("#selectDonador").append('<option value="">--SIN ESPECIFICAR--</option>');

            $.each(Don, function (i, arti) {
                $("#selectDonador").append('<option value="' + arti.donadorID + '">' + arti.nombre + '</option>');
            });


        })

    </script>


