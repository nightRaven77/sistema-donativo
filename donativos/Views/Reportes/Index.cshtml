<body class="bg-light">
    <div class="container">  
        <main>
            <div class="py-3 text-center">
                <img class="d-block mx-auto mb-4" src="~/assets/imagenes/logodif.png" alt="" width="200" height="">
                @* <h2>Registro de donaciones</h2>
				<h4>
					Emergencia en Tula de Allende
				</h4> *@
            </div>
            <div class="py-1 text-center">
                <h2>Consulta de Reportes</h2>

            </div>
            <div class="py-1 text-end">
                <input type="button" name="name" value="Regresar" onclick="location.href='@Url.Action("Regresar", "Reportes")'" />
            </div>

            <hr style="padding: 10px;" />

            <div class="form-group">
                <div class="input-froup w-100">
                    <label for="listado">*<b>Tipo de Reporte</b></label>
                    <div>
                        <input type="radio" id="listado" name="formato" value="listado">
                        <label for="listado">Listado</label>
                    </div>
                    <div>
                        <input type="radio" id="totales" name="formato" value="totales">
                        <label for="totales">Totales</label>
                    </div>
                    <div>
                        <input type="radio" id="donadores" name="formato" value="donadores">
                        <label for="donadores">Donadores</label>
                    </div>
                    <div>
                        <input type="radio" id="categoria" name="formato" value="categoria">
                        <label for="categoria">Donador y Categoria</label>
                    </div>
                    <div>
                        <input type="radio" id="fecha" name="formato" value="fecha">
                        <label for="fecha">Fecha y Categoria</label>
                    </div>
                    <div>
                        <input type="radio" id="centro" name="formato" value="centro">
                        <label for="centro">Centro de Acopio y Categoria</label>
                    </div>
                    @* <div>
                        <input type="radio" id="mensajeCategorias" name="formato" value="mensajeCategorias">
                        <label for="mensajeCategorias">Mensaje de Categorias</label>
                    </div> *@
                    <div>
                        <input type="radio" id="mensajeDonadores" name="formato" value="mensajeDonadores">
                        <label for="mensajeDonadores">Mensaje de Donadores</label>
                    </div>

                </div>
            </div>
            <div class="row">
                <div class="col-6">
                    <label for="textDonador"><b title="Es el nombre de quien lleva la mercancía al centro de acopio.">Donador (persona, empresa o institución)</b>: <i></i></label>
                    <div class="input-group w-100">
                        <span class="input-group-text" id="basic-addon1">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                            </svg>
                        </span>
                        <input type="text" class="form-control" placeholder="Buscar donador" value="" autocomplete="off" id="textDonador">
                    </div>
                    <select class="form-control" id="selectDonador">
                        <option>--SELECCIONE UNA OPCIÓN--</option>
                    </select>
                </div>

                <div class="col-6">
                    <label> <b> Centro de Acopio:  </b></label>
                    <div class="input-group w-100">
                        <select id="centroAcopio" name="centroAcopio" class="form-control">
                            @if (centrosAcopio != null && centrosAcopio.Count > 0)
                            {
                                <option value="">--SIN ESPECIFICAR--</option>
                                foreach (var centro in centrosAcopio)
                                {
                                    <option value="@centro.CentroID">@centro.centroAcopio</option>
                                }
                            }
                            else
                            {
                                <option value="">No hay centros de acopio disponibles</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col">
                    <label for="FechaInicio"><b>Fecha de Inicio</b>:</label>
                    <div class="input-group w-100">
                        <span class="input-group-text" id="basic-addon1">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                            </svg>
                        </span>
                        <input type="date" class="form-control" id="txtFecInicio" placeholder="Fecha Inicio" value="" autocomplete="off">
                    </div>
                </div>
                <div class="col">
                    <label for="FechaFinal"><b>Fecha de Final</b>:</label>
                    <div class="input-group w-100">
                        <span class="input-group-text" id="basic-addon1">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                            </svg>
                        </span>
                        <input type="date" class="form-control" id="txtFecFinal" placeholder="Fecha Final" value="" autocomplete="off">
                    </div>
                </div>
            </div>


            <hr class="my-4">
            <button class="w-100 btn btn-primary btn-lg" id="exportar">Exportar Información</button>
        </main>
        <footer class="my-5 pt-5 text-muted text-center text-small">
            <p class="mb-1">Sistema DIF Hidalgo</p>

        </footer>
    </div>


    <script src="~/assets/dist/js/bootstrap.bundle.min.js"></script>

    <script src="form-validation.js"></script>
</body>
</html>