@using donativos.Models
@*
	For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{

}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="">
    <meta name="author" content="">
    <meta name="generator" content="">
    <title>DIF Hidalgo</title>

    <link rel="canonical" href="https://getbootstrap.com/docs/5.1/examples/checkout/">

    <!-- Bootstrap core CSS -->
    <link href="~/assets/dist/css/bootstrap.min.css" rel="stylesheet">
    <!--[if lte IE 8]><script src="~/assets/js/ie/html5shiv.js"></script><![endif]-->
    <script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.4.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.1/jquery.validate.min.js"></script>
    <script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>
    <!--[if lte IE 9]><link rel="stylesheet" href="~/assets/css/ie9.css" /><![endif]-->
    <!--[if lte IE 8]><link rel="stylesheet" href="~/assets/css/ie8.css" /><![endif]-->
    <!-- Custom styles for this template -->
    <link href="~/form-validation.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container">
        <main>
            <div class="py-1 text-end">
                <input type="button" name="name" value="Regresar" class="btn btn-light" onclick="location.href='@Url.Action("Regresar", "Reportes")'" />
                <input type="button" name="name" value="Cerrar sesión" class="btn btn-light" onclick="location.href='@Url.Action("CerrarSesion", "Registros")'" />
            </div>
            <div class="py-3 text-center">
                <img class="d-block mx-auto mb-4" src="~/assets/imagenes/logodif.png" alt="Logo DIF" width="200">
            </div>
            <div class="py-1 text-center">
                <h2>Registro de Salidas</h2>
            </div>
            <hr style="padding: 10px;" />
            <form class="needs-validation" novalidate>
                <div class="form-group">
                    <label for=" txtConductor">*<b title="Es el nombre de la persona encargada de trasnportar">1. Conductor</b>:</label>

                    <br />

                    <div class="row">
                        <div class="align-content-md-start col-3">
                            <label>1. Busqueda de Conductor</label>
                            <div class="input-group w-100">
                                <span class="input-group-text" id="basic-addon1">
                                    <ion-icon name="search-outline"></ion-icon>
                                </span>
                                <input type="text" class="form-control" placeholder="Buscar Conductor" value="" autocomplete="off"
                                       id="txtConductor">
                            </div>
                        </div>
                        <div class="align-content-between col-3">
                            <label>1.1 Telefono del Conductor</label>
                            <input type="tel" class="form-control" id="txtTelConductor" placeholder="Telefono" value="" pattern="^\d{10}$">
                        </div>
                        <div class="align-content-end col-6">
                            <label>1.2 Selecciona el Conductor o Guardar el nuevo Conductor</label>

                            <div class="row">
                                <div class="col-6">
                                    <select class="form-control" id="selectConductor" onchange="telefonoConductor()" required>
                                        <option>--Selecciona una Opción--</option>
                                    </select>
                                </div>
                                <div class="col-6">
                                    <button id="btnConductor" type="button" class="btn btn-secondary" onclick="agregaConductor()">Guardar Conductor</button>
                                </div>
                            </div>

                        </div>
                    </div>
                    <div class="invalid-feedback">
                        Este dato es requerido.
                    </div>
                </div>
                <hr style="padding: 1px;" />

                <label>*<b tittle="Es el destino al cual va a salir">2. Destino:</b></label>
                <br />
                <div class="row">
                    <div class="align-content-md-start col-6">
                        <label>1. Busqueda de Destino</label>
                        <div class="input-group w-100">
                            <span class="input-group-text" id="basic-addon1">
                                <ion-icon name="search-outline"></ion-icon>
                            </span>
                            <input type="text" class="form-control" placeholder="Buscar Destino" value="" autocomplete="off"
                                   id="txtDestino">
                        </div>
                    </div>
                    <div class="align-content-end col-6">
                        <label>1.2 Selecciona el Destino o Guardar el nuevo Destino</label>

                        <div class="row">
                            <div class="col-6">
                                <select class="form-control" id="selectDestino" onchange="" required>
                                    <option>--Selecciona una Opción--</option>
                                </select>
                            </div>
                            <div class="col-6">
                                <button id="btnAgregarDestino" type="button" class="btn btn-secondary" onclick="agregaDestino()">Guardar Destino</button>
                            </div>
                        </div>

                    </div>
                </div>
                <hr style="padding: 1px;" />

                <label>*<b tittle="Datos generales">3. Datos generales:</b></label>
                <br />
                <div class="row">
                    <div class="align-content-md-start col-3">
                        <label>1. Localidad</label>
                        <div class="input-group w-100">
                            <input type="text" class="form-control" placeholder="Localidades a donde llegara" value="" autocomplete="off"
                                   id="txtLocalidad">
                        </div>
                    </div>
                    <div class="align-content-md-end col-3">
                        <label>1.2 Placa del Vehiculo</label>

                        <div class="row">
                            <div class="col-12">
                                <input type="text" class="form-control" placeholder="Placa del vehiculo" value="" autocomplete="off"
                                       id="txtPlacaVehiculo">
                            </div>
                        </div>
                    </div>
                    <div class="align-content-md-start col-6">
                        <label>1.2 Dependencia</label>
                        <div class="row">
                            <div class="col-12">
                                <input type="text" class="form-control" placeholder="Dependencia" value="" autocomplete="off"
                                       id="txtDependencia">
                            </div>
                        </div>

                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="align-content-md-start col-12">
                        <div class="row">
                            <div class="col-12">
                                <label>Tipo de Salida:</label>
                                <div class="d-flex align-items-center">
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="salidaTipo" id="salida_SEGOB" value="SEGOB" checked>
                                        <label class="form-check-label" for="salida_SEGOB">SEGOB</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="salidaTipo" id="salidaHangar" value="Hangar">
                                        <label class="form-check-label" for="salidaHangar">Hangar</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="salidaTipo" id="salidaOficialia" value="Oficialia">
                                        <label class="form-check-label" for="salidaOficialia">Oficialia</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="salidaTipo" id="salidaCentral" value="Central">
                                        <label class="form-check-label" for="salidaCentral">Central</label>
                                    </div>
                                </div>
                                <input type="hidden" id="selectedSalida" value="SEGOB" />
                            </div>
                        </div>
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="align-content-md-start col-6">
                        <label>1.3. Busqueda de Artículo</label>
                        <div class="input-group w-100">
                            <span class="input-group-text" id="basic-addon1">
                                <ion-icon name="search-outline"></ion-icon>
                            </span>
                            <input type="text" class="form-control" placeholder="Buscar Artículo" value="" autocomplete="off"
                                   id="txtArticulo">
                        </div>
                    </div>

                    <div class="align-content-end col-6">
                        <label>1.4 Selecciona el Artículo o Guardar el nuevo Artículo</label>

                        <div class="row">
                            <div class="col-6">
                                <select class="form-control" id="selectArticulo" onchange="" required>
                                    <option>--Selecciona una Opción--</option>
                                </select>
                            </div>
                            <div class="col-6">
                                <button id="btnAgregarArticulo" type="button" class="btn btn-secondary" onclick="agregaArticulo()">Guardar Artículo</button>
                            </div>
                        </div>

                    </div>
                </div>
                <hr style="padding: 1px;" />
                <div class="row">
                    <div class="align-content-md-start col-3">
                        <label for="textCantidad">*<b title="Es el número de elementos.">Cantidad</b>: <i></i></label>
                        <input type="number" class="form-control" id="txtCantidad" placeholder="Cantidad" value="0" step="any" required>
                        <div class="invalid-feedback">
                            Este dato es requerido.
                        </div>
                    </div>
                    <div class="align-content-md-start col-9">
                        <label for="textObservaciones">*<b title="Es el número de elementos.">Obsrvaciones</b>: <i></i></label>
                        <input type="text" class="form-control" id="textObservaciones" placeholder="Observaciones">
                    </div>
                </div><br />
                <div class="row">
                    <div class="align-content-md-start col-8">
                        <button id="btnAgregarRegistro" type="button" class="btn btn-outline-success btn-lg" onclick="agregaSalidas()"><span><ion-icon name="save-outline"></ion-icon></span> Guardar Registro</button>
                    </div>
                </div>
            </form>

            <hr style="padding: 10px; color:crimson" />

            <div class="py-3 text-center">
                <h2>Consulta de registros</h2>
            </div>

            <div class="container" style="padding-top:50px">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div>
                        <label class="me-2">Rows per page:</label>
                        <select id="pageSizeSelect" class="form-select d-inline-block" style="width:auto;">
                            <option value="5">5</option>
                            <option value="10" selected>10</option>
                            <option value="25">25</option>
                        </select>
                    </div>
                    <div>
                        <nav aria-label="Table pagination">
                            <ul class="pagination mb-0" id="registrosPagination"></ul>
                        </nav>
                    </div>
                </div>

                <table class="table table-striped table-sm" id="registros" aria-describedby="registrosPagination">
                    <thead>
                        <tr>
                            <th scope="col">Acciones</th>
                            <th scope="col"></th>
                            <th scope="col" data-key="folio" data-sortable="true" class="sortable">Folio <span class="sort-indicator"></span></th>
                            <th scope="col" data-key="fecha" data-sortable="true" class="sortable">Fecha <span class="sort-indicator"></span></th>
                            <th scope="col" data-key="nombreConductor" data-sortable="true" class="sortable">Conductor <span class="sort-indicator"></span></th>
                            <th scope="col" data-key="telefonoConductor" data-sortable="true" class="sortable">Teléfono <span class="sort-indicator"></span></th>
                            <th scope="col" data-key="nombreArticulo" data-sortable="true" class="sortable">Artículo <span class="sort-indicator"></span></th>
                            <th scope="col" data-key="cantidad" data-sortable="true" class="sortable">Cantidad <span class="sort-indicator"></span></th>
                            <th scope="col" data-key="nombreDestino" data-sortable="true" class="sortable">Destino <span class="sort-indicator"></span></th>
                            <th scope="col" data-key="placaVehiculo" data-sortable="true" class="sortable">Placa <span class="sort-indicator"></span></th>
                            <th scope="col" data-key="localidad" data-sortable="true" class="sortable">Localidad <span class="sort-indicator"></span></th>
                            <th scope="col" data-key="observaciones" data-sortable="true" class="sortable">Observaciones <span class="sort-indicator"></span></th>
                            <th scope="col" data-key="dependencia" data-sortable="true" class="sortable">Dependencia <span class="sort-indicator"></span></th>
                            <th scope="col" data-key="salida" data-sortable="true" class="sortable">Salida <span class="sort-indicator"></span></th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>

            <div class="modal fade" id="editarSalidaModal" tabindex="-1" aria-labelledby="editarSalidaLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="editarSalidaLabel">Editar Registro de Salida</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <form id="formEditarSalida">
                                <div class="form-group mb-3">
                                    <label for="editConductor">Conductor:</label>
                                    <select class="form-control" id="editConductor" required>
                                        <option>--Selecciona una Opción--</option>
                                    </select>
                                </div>

                                <div class="form-group mb-3">
                                    <label for="editDestino">Destino:</label>
                                    <select class="form-control" id="editDestino" required>
                                        <option>--Selecciona una Opción--</option>
                                    </select>
                                </div>

                                <div class="form-group mb-3">
                                    <label for="editArticulo">Artículo:</label>
                                    <select class="form-control" id="editArticulo" required>
                                        <option>--Selecciona una Opción--</option>
                                    </select>
                                </div>

                                <div class="form-group mb-3">
                                    <label for="editCantidad">Cantidad:</label>
                                    <input type="number" class="form-control" id="editCantidad" placeholder="Cantidad" step="any" required>
                                </div>

                                <div class="form-group mb-3">
                                    <label for="editPlacaVehiculo">Placa del Vehículo:</label>
                                    <input type="text" class="form-control" id="editPlacaVehiculo" placeholder="Placa del vehículo">
                                </div>

                                <div class="form-group mb-3">
                                    <label for="editLocalidad">Localidad:</label>
                                    <input type="text" class="form-control" id="editLocalidad" placeholder="Localidad">
                                </div>

                                <div class="form-group mb-3">
                                    <label for="editObservaciones">Observaciones:</label>
                                    <input type="text" class="form-control" id="editObservaciones" placeholder="Observaciones">
                                </div>

                                <div class="form-group mb-3">
                                    <label for="editDependencia">Dependencia:</label>
                                    <input type="text" class="form-control" id="editDependencia" placeholder="Dependencia">
                                </div>

                                <div class="form-group mb-3">
                                    <label>Tipo de Salida:</label>
                                    <div class="d-flex align-items-center">
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio" name="editSalidaTipo" id="editSalida_SEGOB" value="SEGOB">
                                            <label class="form-check-label" for="editSalida_SEGOB">SEGOB</label>
                                        </div>
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio" name="editSalidaTipo" id="editSalidaHangar" value="Hangar">
                                            <label class="form-check-label" for="editSalidaHangar">Hangar</label>
                                        </div>
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio" name="editSalidaTipo" id="editSalidaOficialia" value="Oficialia">
                                            <label class="form-check-label" for="editSalidaOficialia">Oficialia</label>
                                        </div>
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio" name="editSalidaTipo" id="editSalidaCentral" value="Central">
                                            <label class="form-check-label" for="editSalidaCentral">Central</label>
                                        </div>
                                    </div>
                                </div>

                                <input type="hidden" id="editRegistroID" value="">
                            </form>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="button" class="btn btn-primary" id="btnGuardarEdicion" onclick="guardarEdicion()">Guardar Cambios</button>
                        </div>
                    </div>
                </div>
            </div>
        </main>
        <footer class="my-5 pt-5 text-muted text-center text-small">
            <p class="mb-1">Sistema DIF Hidalgo</p>
        </footer>
    </div>

    <script src="~/assets/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/form-validation.js"></script>
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
    <script src="@Url.Content("~/Scripts/salidasUtils.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/salidasTable.js")" type="text/javascript"></script>
    <script type="text/javascript">
        //Variable global
        window.aValue = "@ViewBag.a";

        $(document).ready(function () {
            //Carga Iniciales de los Catálogos
           var conductorJson = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Conductor))
          salidasUtils.cargarConductores(JSON.parse(conductorJson));

           var destinoJson = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Destino))
          salidasUtils.cargarDestinos(JSON.parse(destinoJson));

           var articuloSalidasJson = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ArticuloSalidas))
          salidasUtils.cargarArticulos(JSON.parse(articuloSalidasJson));

          // Cargar los selects del modal
          salidasUtils.cargarSelectsModal(
            JSON.parse(articuloSalidasJson),
            JSON.parse(destinoJson),
            JSON.parse(conductorJson)
          );

          // Manejador para mantener el valor seleccionado en el hidden input
          $('input[name="salidaTipo"]').on("change", function () {
            $("#selectedSalida").val($(this).val());
          });


          // Carga de la tabla
           var registrosJson = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.RegistrosSalidas ?? new object[] { }));
          try {
            var registros = JSON.parse(registrosJson);
            SalidasTable.setData(registros);
          } catch (ex) {
            console.error("Failed to parse RegistrosSalidas", ex);
            SalidasTable.setData([]);
          }

              // Eventos de búsqueda en tiempo real
        $("#txtConductor").on("keyup", function () {
            var searchText = $(this).val();
            salidasUtils.filtrarConductores(searchText);
        });

        $("#txtDestino").on("keyup", function () {
            var searchText = $(this).val();
            salidasUtils.filtrarDestinos(searchText);
        });

        $("#txtArticulo").on("keyup", function () {
            var searchText = $(this).val();
            salidasUtils.filtrarArticulos(searchText);
        });
        });

        // Función para guardar desde el botón del modal
        function guardarEdicion() {
          window.salidasUtils.guardarEdicionRegistro(window.aValue);
        }

        // Función de Guardado de Salidas
        function agregaSalidas() {
          var url = '@Url.Action("insertaRegistroSalida", "Salidas")';
          salidasUtils.agregaSalidas(url, window.aValue);
        }
        // Función para el guardado de nuevos conductores, destinos, articulos
        function agregaConductor() {
          var url = '@Url.Action("insertaConductor", "Salidas")';
          salidasUtils.agregaConductor(url, window.aValue);
        }

        function agregaDestino() {
          var url = '@Url.Action("insertaDestinos", "Salidas")';
          salidasUtils.agregaDestino(url, window.aValue);
        }

        function agregaArticulo() {
          var url = '@Url.Action("insertaArticuloSalida", "Salidas")';
          salidasUtils.agregaArticulos(url, window.aValue);
        }

        //el telefono al conductor seleccionado
        function telefonoConductor() {
          var url = '@Url.Action("buscaConductor", "Salidas")';
          salidasUtils.telefonoConductor(url, window.aValue);
        }
    </script>

</body>
</html>
