        </div>
    </div>

    <!-- Barra superior móvil -->
    <header class="mobile-topbar">
        <button type="button" onclick="App.toggleMobileSidebar()" class="text-white border-0 bg-transparent p-2" aria-label="Abrir menú de navegación">
            <i class="fas fa-bars text-xl" aria-hidden="true"></i>
        </button>
        <span class="font-bold text-sm tracking-wide">Sistema de Donativos</span>
        <span class="text-xs text-stone-300 truncate" style="max-width: 140px;">@ViewBag.centro</span>
    </header>
    <div id="sidebarBackdrop" class="sidebar-backdrop" onclick="App.closeMobileSidebar()" aria-hidden="true"></div>

    <div class="flex min-h-screen">
        <!-- Sidebar -->
        <aside id="appSidebar" class="w-64 text-white flex-shrink-0 shadow-xl fixed h-full z-50" aria-label="Barra lateral">
            <div class="sidebar-header">
                <img src="~/assets/imagenes/logo.png" alt="Logotipo Sistema de Donativos" class="w-full" style="max-height: 54px; object-fit: contain;">
                <p class="text-stone-400 uppercase mt-2 font-semibold" style="font-size: 0.68rem; letter-spacing: 0.08em; margin-bottom: 0;">Control de Inventario y Acopio</p>
            </div>

            <nav class="sidebar-nav" aria-label="Navegación principal">
                <div class="sidebar-section-label">Recepción</div>
                <a href="#inicio" onclick="App.loadView(event, 'inicio'); return false;" class="sidebar-item active-tab flex items-center px-6 py-3" aria-current="page">
                    <i class="fas fa-home w-6" style="color:var(--dorado)" aria-hidden="true"></i>
                    <span class="ml-3">Inicio</span>
                </a>
                <a href="#registros" onclick="App.loadView(event, 'registros'); return false;" class="sidebar-item flex items-center px-6 py-3">
                    <i class="fas fa-plus-circle w-6" style="color:var(--dorado)" aria-hidden="true"></i>
                    <span class="ml-3">Nuevo Registro</span>
                </a>
                <a href="#consulta" onclick="App.loadView(event, 'consulta'); return false;" class="sidebar-item flex items-center px-6 py-3">
                    <i class="fas fa-search w-6" style="color:var(--dorado)" aria-hidden="true"></i>
                    <span class="ml-3">Consulta e Inventario</span>
                </a>

                <div class="sidebar-section-label mt-3">Operaciones</div>
                <a href="#salidas" onclick="App.loadView(event, 'salidas'); return false;" class="sidebar-item flex items-center px-6 py-3">
                    <i class="fas fa-arrow-up w-6" style="color:var(--dorado)" aria-hidden="true"></i>
                    <span class="ml-3">Salidas</span>
                </a>
                <a href="#traspasos" onclick="App.loadView(event, 'traspasos'); return false;" class="sidebar-item flex items-center px-6 py-3">
                    <i class="fa-solid fa-arrows-left-right w-6" style="color:var(--dorado)" aria-hidden="true"></i>
                    <span class="ml-3">Traspasos</span>
                </a>
                <a href="#reportes" onclick="App.loadView(event, 'reportes'); return false;" class="sidebar-item flex items-center px-6 py-3">
                    <i class="fa-solid fa-file-lines w-6" style="color:var(--dorado)" aria-hidden="true"></i>
                    <span class="ml-3">Reportes Excel</span>
                </a>
                <a href="#dashboard" onclick="App.loadView(event, 'dashboard'); return false;" class="sidebar-item flex items-center px-6 py-3">
                    <i class="fas fa-chart-line w-6" style="color:var(--dorado)" aria-hidden="true"></i>
                    <span class="ml-3">Panel Operativo</span>
                </a>

                <div class="sidebar-section-label mt-3">Sesión</div>
                <form action="@Url.Action("CerrarSesion", "Registros")" method="post" style="margin: 0;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="sidebar-item flex items-center px-6 py-3 text-red-400 hover:text-red-300 w-full text-left border-0 bg-transparent cursor-pointer">
                        <i class="fas fa-sign-out-alt w-6" aria-hidden="true"></i>
                        <span class="ml-3">Cerrar Sesión</span>
                    </button>
                </form>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 p-6">
            <!-- Barra de contexto operativa -->
            <header class="app-topbar">
                <div>
                    <h1 class="app-topbar-title" id="currentViewHeading">Centro de Recepción y Logística</h1>
                    <p class="app-topbar-subtitle" id="currentViewSubtitle">Gestión integral de entradas, existencias, entregas y traspasos</p>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="meta-pill" title="Almacén o Centro Asignado">
                        <i class="fas fa-warehouse" aria-hidden="true"></i>
                        <span>@(string.IsNullOrWhiteSpace(ViewBag.centro?.ToString()) ? "Almacén General" : ViewBag.centro)</span>
                    </span>
                    <span class="meta-pill" title="Operador en sesión">
                        <i class="fas fa-user-check" aria-hidden="true"></i>
                        <span>@(string.IsNullOrWhiteSpace(ViewBag.usuario?.ToString()) ? "Operador" : ViewBag.usuario)</span>
                    </span>
                </div>
            </header>

            <!-- Dynamic Content Container -->
            <div id="contentContainer" tabindex="-1"></div>
        </main>
    </div>

                    <script src="~/assets/dist/js/bootstrap.bundle.min.js"></script>
                    <script>
                        // Variables globales de sesión del usuario
                        const usuarioSession = {
                        centroID: '@Context.Session.GetString("CentroID")'
                        // usuario: '@Context.Session.GetString("usuario")',
                        // centroAcopio: '@Context.Session.GetString("centroAcopio")',
                        // token: '@Context.Session.GetString("token")'
                        };

                        // console.log('Información de sesión cargada:', usuarioSession);

                        // Configurar Toastr
                        toastr.options = {
                        "closeButton": true,
                        "debug": false,
                        "newestOnTop": true,
                        "progressBar": true,
                        "positionClass": "toast-top-right",
                        "preventDuplicates": true,
                        "onclick": null,
                        "showDuration": 300,
                        "hideDuration": 1000,
                        "timeOut": 5000,
                        "extendedTimeOut": 1000,
                        "showEasing": "swing",
                        "hideEasing": "linear",
                        "showMethod": "fadeIn",
                        "hideMethod": "fadeOut"
                        };

                        // Aplicación SPA Principal
                        const App = {
                        currentView: 'inicio',
                        bodegaId: '@ViewBag.a',
                        viewTitles: {
                        'inicio': 'Cargando página de inicio',
                        'registros': 'Cargando formulario de registro',
                        'consulta': 'Cargando consulta de registros',
                        'salidas': 'Cargando salidas',
                        'traspasos': 'Cargando traspasos',
                        'reportes': 'Cargando reportes',
                        'dashboard': 'Cargando dashboard'
                        },
                        viewHeaders: {
                        'inicio': {
                        title: 'Panel de Operaciones',
                        subtitle: 'Selecciona un módulo operativo para gestionar entradas, salidas, traspasos o inventario'
                        },
                        'registros': {
                        title: 'Registro de Donativos (Entradas)',
                        subtitle: 'Captura de donativos en especie o efectivo e ingreso directo a inventario'
                        },
                        'consulta': {
                        title: 'Consulta de Movimientos e Inventario',
                        subtitle: 'Búsqueda avanzada por folio, monitoreo de existencias y alertas de stock'
                        },
                        'salidas': {
                        title: 'Gestión de Salidas y Entregas',
                        subtitle: 'Registro de entregas a beneficiarios, bajas por merma y control de folios'
                        },
                        'traspasos': {
                        title: 'Traspasos entre Almacenes',
                        subtitle: 'Envío, recepción y trazabilidad de mercancía entre centros de acopio'
                        },
                        'reportes': {
                        title: 'Centro de Reportes y Exportación',
                        subtitle: 'Generación de reportes operativos y kardex en formato Excel (.xlsx)'
                        },
                        'dashboard': {
                        title: 'Indicadores Operativos en Tiempo Real',
                        subtitle: 'Resumen de actividad del almacén y accesos directos de gestión'
                        }
                        },

                        init() {
                        this.loadViewInternal('inicio');
                        },

                        toggleMobileSidebar() {
                        document.getElementById('appSidebar')?.classList.toggle('mobile-open');
                        document.getElementById('sidebarBackdrop')?.classList.toggle('active');
                        },

                        closeMobileSidebar() {
                        document.getElementById('appSidebar')?.classList.remove('mobile-open');
                        document.getElementById('sidebarBackdrop')?.classList.remove('active');
                        },

                        loadView(event, viewName) {
                        event?.preventDefault();
                        this.closeMobileSidebar();
                        this.loadViewInternal(viewName);
                        },

                        loadViewInternal(viewName) {
                        const container = document.getElementById('contentContainer');
                        const loader = document.getElementById('loadingSpinner');
                        const spinnerText = document.getElementById('spinnerText');

                        // ⭐ LIMPIAR DATATABLES ANTES DE CAMBIAR DE VISTA
                        if (typeof dataTable !== 'undefined' && dataTable !== null) {
                        dataTable.destroy();
                        dataTable = null;
                        }
                        if (typeof dataTableSalidas !== 'undefined' && dataTableSalidas !== null) {
                        console.log('🧹 Destruyendo DataTable Salidas');
                        dataTableSalidas.destroy();
                        dataTableSalidas = null;
                        }
                        if (typeof dataTableTraspasos !== 'undefined' && dataTableTraspasos !== null) {
                        console.log('🧹 Destruyendo DataTable Traspasos');
                        dataTableTraspasos.destroy();
                        dataTableTraspasos = null;
                        }
                        if (typeof tablaMovimientos !== 'undefined' && tablaMovimientos !== null) {
                        console.log('🧹 Destruyendo DataTable Movimientos (Consulta)');
                        tablaMovimientos.destroy();
                        tablaMovimientos = null;
                        }
                        if (typeof tablaInventario !== 'undefined' && tablaInventario !== null) {
                        console.log('🧹 Destruyendo DataTable Inventario (Consulta)');
                        tablaInventario.destroy();
                        tablaInventario = null;
                        }

                        // Actualizar texto del spinner
                        spinnerText.textContent = this.viewTitles[viewName] || 'Por favor espera...';

                        // Mostrar loader
                        loader.classList.add('active');

                        $.ajax({
                        type: 'GET',
                        url: '@Url.Action("GetView", "Registros")',
                        data: { viewName: viewName, a: this.bodegaId },
                        success: (html) => {
                        loader.classList.remove('active');
                        container.innerHTML = html;
                        this.currentView = viewName;
                        $("html,body").animate({ scrollTop: 0 }, 300);

                        // Marcar como activa la opción del menú correspondiente y actualizar encabezado
                        this.updateActiveMenu(viewName);

                        // ⭐ INICIALIZAR MÓDULOS SEGÚN LA VISTA CARGADA
                        if (viewName === 'registros') {
                        if (typeof initRegistrosForm === 'function') {
                        initRegistrosForm();
                        }

                        setTimeout(() => {
                        document.dispatchEvent(new Event('registrosViewLoaded'));
                        }, 100);
                        } else if (viewName === 'salidas') {
                        // Inicializar módulo de salidas
                        if (typeof inicializarSalidas === 'function') {
                        console.log('🚀 Inicializando módulo Salidas');
                        // ⭐ Esperar a que el DOM esté completamente renderizado
                        setTimeout(() => {
                        inicializarSalidas();
                        }, 300);
                        }
                        } else if (viewName === 'traspasos') {
                        // Inicializar módulo de traspasos
                        if (typeof inicializarTraspasos === 'function') {
                        console.log('🚀 Inicializando módulo Traspasos');
                        // ⭐ Esperar a que el DOM esté completamente renderizado
                        setTimeout(() => {
                        inicializarTraspasos();
                        }, 300);
                        }
                        } else if (viewName === 'reportes') {
                        // Inicializar módulo de reportes
                        if (typeof inicializarReportes === 'function') {
                        console.log('🚀 Inicializando módulo Reportes');
                        // ⭐ Esperar a que el DOM esté completamente renderizado
                        setTimeout(() => {
                        inicializarReportes();
                        }, 300);
                        }
                        } else if (viewName === 'consulta') {
                        // Inicializar módulo de consulta
                        if (typeof inicializarConsulta === 'function') {
                        console.log('🚀 Inicializando módulo Consulta');
                        // ⭐ Esperar a que el DOM esté completamente renderizado
                        setTimeout(() => {
                        inicializarConsulta();
                        }, 300);
                        }
                        } else if (viewName === 'dashboard') {
                        this.loadDashboardStats();
                        }
                        },
                        error: (xhr, status, error) => {
                        loader.classList.remove('active');
                        toastr.error('Error al cargar la vista: ' + error, 'Error');
                        console.error(error);
                        }
                        });
                        },

                        async loadDashboardStats() {
                        if (typeof AjaxService === 'undefined') return;
                        const setKpi = (id, val) => {
                        const el = document.getElementById(id);
                        if (el) el.textContent = val; }; const parseList = (res) => { if (!res) return []; let v = res.status === 'fulfilled' ? res.value : res; if (!v) return []; if (typeof v === 'string') { try { v = JSON.parse(v); } catch { return []; } } if (Array.isArray(v)) return v; if (v && Array.isArray(v.data)) return v.data; if (v && Array.isArray(v.donativos)) return v.donativos; if (v && Array.isArray(v.salidas)) return v.salidas; if (v && Array.isArray(v.traspasos)) return v.traspasos; if (v && Array.isArray(v.items)) return v.items; return [];
                        };
                        try {
                        const [donativosRes, salidasRes, traspasosRes] = await Promise.allSettled([
                        AjaxService.donativos ? AjaxService.donativos.obtenerTodos() : AjaxService.get('/Registros/ObtenerDonativos'),
                        AjaxService.salidas ? AjaxService.salidas.obtenerTodas() : AjaxService.get('/Registros/ObtenerSalidas'),
                        AjaxService.traspasos ? AjaxService.traspasos.obtenerTodos() : AjaxService.get('/Registros/ObtenerTraspasos')
                        ]);

                        const donativos = parseList(donativosRes); if (donativos) {
                        const activos = donativos.filter(d => (d.estatus || '').toLowerCase() !== 'cancelado');
                        setKpi('kpiTotalDonativos', activos.length.toLocaleString('es-MX')); const tbody = document.getElementById('tbodyDonativosRecientesDashboard'); if (tbody) { if (donativos.length === 0) { tbody.innerHTML = '<tr><td colspan="7" class="text-center text-stone-500 py-3">No hay donativos registrados aún.</td></tr>'; } else { tbody.innerHTML = donativos.slice(0, 5).map(d => `<tr><td class="font-bold text-stone-800">${d.folio || ('#' + d.idDonativo)}</td><td>${d.nombre || d.nombreDonador || d.donador || 'N/A'}</td><td>${d.fechaRecepcion ? new Date(d.fechaRecepcion).toLocaleDateString('es-MX') : 'N/A'}</td><td><span class="badge bg-secondary text-uppercase">${d.tipo || 'Especie'}</span></td><td><span class="badge bg-success">${d.estatus || 'Recibido'}</span></td><td>${d.cantidadArticulos || 1}</td><td class="text-end"><button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 me-1" onclick="window.open('/Registros/ImprimirDonativo?id=' + d.idDonativo + '&autoPrint=true', '_blank')" title="Imprimir"><i class="fas fa-print"></i></button><button type="button" class="btn btn-sm btn-outline-primary py-0 px-2" onclick="App.loadView(event, 'registros')"><i class="fas fa-eye"></i> Ver</button></td></tr>`).join(''); } }
                        } else {
                        setKpi('kpiTotalDonativos', '0');
                        }

                        const salidas = parseList(salidasRes); if (salidas) {
                        setKpi('kpiTotalSalidas', salidas.length.toLocaleString('es-MX'));
                        } else {
                        setKpi('kpiTotalSalidas', '0');
                        }

                        const traspasos = parseList(traspasosRes); if (traspasos) {
                        const lista = traspasos;
                        const pendientes = lista.filter(t => (t.estado || '').toLowerCase() === 'pendiente').length;
                        const aprobados = lista.filter(t => (t.estado || '').toLowerCase() === 'aprobado').length;
                        setKpi('kpiTraspasosPendientes', pendientes.toLocaleString('es-MX'));
                        setKpi('kpiTraspasosAprobados', aprobados.toLocaleString('es-MX'));
                        } else {
                        setKpi('kpiTraspasosPendientes', '0');
                        setKpi('kpiTraspasosAprobados', '0');
                        }
                        } catch (e) {
                        console.warn('No se pudieron cargar los indicadores del dashboard:', e);
                        }
                        },

                        updateActiveMenu(viewName) {
                        const menuItems = {
                        'inicio': 0,
                        'registros': 1,
                        'consulta': 2,
                        'salidas': 3,
                        'traspasos': 4,
                        'reportes': 5,
                        'dashboard': 6
                        };

                        const items = document.querySelectorAll('.sidebar-nav .sidebar-item');
                        items.forEach((item, index) => {
                        item.classList.remove('active-tab');
                        item.removeAttribute('aria-current');
                        if (menuItems[viewName] === index) {
                        item.classList.add('active-tab');
                        item.setAttribute('aria-current', 'page');
                        }
                        });

                        const headerMeta = this.viewHeaders[viewName];
                        if (headerMeta) {
                        const headingEl = document.getElementById('currentViewHeading');
                        const subtitleEl = document.getElementById('currentViewSubtitle');
                        if (headingEl) headingEl.textContent = headerMeta.title;
                        if (subtitleEl) subtitleEl.textContent = headerMeta.subtitle;
                        }
                        }
                        };

                        // Inicializar aplicación al cargar
                        $(document).ready(() => {
                        App.init();
                        });
                    </script>
                </body>
            </html>
